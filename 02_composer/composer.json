{
    "name": "dest1n640/shop",
    "description": "Набор зависимостей интернет-магазина",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-pdo": "*",
        "doctrine/dbal": "^4.5",
        "symfony/cache": "^8.1",
        "predis/predis": "^3.6",
        "phpoffice/phpspreadsheet": "^5.10",
        "mpdf/mpdf": "^8.3",
        "twilio/sdk": "^8.12",
        "symfony/mailer": "^8.1",
        "league/flysystem-aws-s3-v3": "^3.35",
        "lapaygroup/russianpost": "^2.0",
        "hybridauth/hybridauth": "^3.13",
        "bukashk0zzz/yml-generator": "^2.1",
        "yoomoney/yookassa-sdk-php": "^3.16"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "suggest": {
        "ext-redis": "Быстрее predis для кеша в Redis",
        "ext-apcu": "Кеш в памяти процесса без Redis (symfony/cache ApcuAdapter)"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
